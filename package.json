{
  "name": "findb",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "setup-db": "node setup-db.js",
    "setup-test-db": "DB_SCHEMA=balancetrack_test node -r ./scripts/use-test-env.js setup-db.js && npm run migrate:test",
    "migrate:test": "DB_SCHEMA=balancetrack_test REQUIRE_TEST_SCHEMA=true node -r ./scripts/use-test-env.js scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "ledger:check": "node scripts/ledger-check.js",
    "ledger:check:test": "DB_SCHEMA=balancetrack_test node -r ./scripts/use-test-env.js scripts/ledger-check.js",
    "reset-test-db": "node -r ./scripts/use-test-env.js reset-test-db.js",
    "reset-test-db-with-user": "node -r ./scripts/use-test-env.js reset-test-db.js --with-user",
    "test": "node scripts/run-api-tests.js",
    "test:clean": "npm run setup-test-db && npm run reset-test-db-with-user -- --yes && npm test",
    "test:unit": "jest --selectProjects unit",
    "test:coverage": "jest --selectProjects unit --coverage",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "FinDB: a personal finance dashboard for India",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cookie-signature": "^1.2.2",
    "eslint": "^10.11.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "testTimeout": 30000,
    "maxWorkers": 1,
    "detectOpenHandles": true,
    "forceExit": true,
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ],
    "coverageDirectory": "coverage",
    "projects": [
      {
        "displayName": "api",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/integration.test.js",
          "<rootDir>/tests/edge-cases.test.js",
          "<rootDir>/tests/bank-deletion-fix.test.js",
          "<rootDir>/tests/cash-balance-activity.test.js",
          "<rootDir>/tests/atomic-writes.test.js",
          "<rootDir>/tests/account-recovery.test.js",
          "<rootDir>/tests/entry-dates.test.js",
          "<rootDir>/tests/activity-api.test.js",
          "<rootDir>/tests/account-ownership.test.js",
          "<rootDir>/tests/ledger.test.js",
          "<rootDir>/tests/security.test.js",
          "<rootDir>/tests/isolation.test.js",
          "<rootDir>/tests/privacy.test.js",
          "<rootDir>/tests/entries.test.js",
          "<rootDir>/tests/categories.test.js",
          "<rootDir>/tests/events.test.js",
          "<rootDir>/tests/recurring.test.js",
          "<rootDir>/tests/reimbursements.test.js",
          "<rootDir>/tests/modules.test.js",
          "<rootDir>/tests/sample-data.test.js",
          "<rootDir>/tests/reconciliation.test.js",
          "<rootDir>/tests/profile.test.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/env.js"
        ],
        "transform": {
          "^.+\\.ts$": [
            "@swc/jest",
            {
              "jsc": {
                "parser": {
                  "syntax": "typescript"
                },
                "target": "es2022"
              },
              "module": {
                "type": "commonjs"
              }
            }
          ]
        }
      },
      {
        "displayName": "scripts",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/setup-db.test.js",
          "<rootDir>/tests/setup-db-coverage.test.js",
          "<rootDir>/tests/no-emoji.test.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/env.js"
        ]
      },
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.ts"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1"
        },
        "transform": {
          "^.+\\.(t|j)sx?$": [
            "@swc/jest",
            {
              "jsc": {
                "parser": {
                  "syntax": "typescript",
                  "tsx": true
                },
                "target": "es2022"
              },
              "module": {
                "type": "commonjs"
              }
            }
          ]
        },
        "collectCoverageFrom": [
          "lib/**/*.ts",
          "src/**/*.ts"
        ]
      }
    ]
  }
}
